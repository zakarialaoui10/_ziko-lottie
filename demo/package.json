{
  "name": "demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node .ziko/server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr .ziko/entry-server.js --outDir dist/server",
    "preview": "cross-env NODE_ENV=production node .ziko/server.js"
  },
  "dependencies": {
    "@zikojs/server" : "workspace:*", 
    "@zikojs/http" : "workspace:*",
    "@zikojs/express" : "workspace:*",
    "@zikojs/koa" : "workspace:*",
    "@zikojs/fastify" : "workspace:*",
    "@zikojs/hono" : "workspace:*",
    "@zikojs/polka" : "workspace:*",
    "ziko" : "catalog:"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "vite": "^8.0.3"
  }
}
